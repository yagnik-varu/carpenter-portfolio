# Copy to .env.local for development, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Every key is optional: without it, that feature quietly switches off (see notes).

# Public site URL, used for canonical links, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Quote form email (https://resend.com, free tier: 3,000 emails/month) ---
# Without RESEND_API_KEY the form still works and logs the email to the server console.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Until then, use the Resend test sender:
QUOTE_FROM_EMAIL="Oak & Grain Website <onboarding@resend.dev>"

# --- Spam protection (https://dash.cloudflare.com → Turnstile, free) ---
# Leave both empty to disable the widget. Test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Reviews (Places API "New") ---
# Google Cloud Console → enable "Places API (New)" → create an API key restricted to that API.
# Also set google.placeId in content/business.json (find it with Google's Place ID Finder).
# Without the key, the site shows the fallback reviews from content/reviews.ts.
# Cost: reviews are cached for 24h, so ~30 requests/month — well inside Google's free monthly credit.
GOOGLE_PLACES_API_KEY=

# --- Search engine indexing ---
# Leave unset on test/preview deployments (dummy data). Set to true ONLY on the real launch domain.
ALLOW_INDEXING=
